# Keeps the Docker build context small and prevents host artefacts from
# overriding anything installed inside the image.
node_modules
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
.vite
npm-debug.log*

# Staging directory of scripts/check-docker-context.py. It is removed after each
# run; ignoring it keeps a crashed run from being copied into the next image.
.docker-context-check
