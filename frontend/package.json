{
  "name": "vps-billing-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "User and admin web clients for the VPS billing platform.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "user-web",
    "admin-web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint shared user-web admin-web --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
