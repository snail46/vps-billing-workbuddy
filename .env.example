# Environment template.
#
# Copy to .env for local development:
#
#   cp .env.example .env
#
# Every value below also has a default in deploy/docker-compose.yml, so the
# foundation environment starts without this file. The defaults are development
# values and must never be used in production.
#
# Secrets belong in a secret manager or the deployment platform's configuration,
# not in a committed file (docs/14-SECURITY.md).

# ---- application -------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:8080

# ---- published ports (host side) --------------------------------------------
SERVER_PORT=8080
USER_WEB_PORT=3000
ADMIN_WEB_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- browser origins ---------------------------------------------------------
# The API allowlists these for CORS, so they must match the ports above.
USER_WEB_ORIGIN=http://localhost:3000
ADMIN_WEB_ORIGIN=http://localhost:3001

# API origin baked into the web bundles and permitted by their CSP.
USER_WEB_API_BASE_URL=http://localhost:8080
ADMIN_WEB_API_BASE_URL=http://localhost:8080

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=vps_billing
POSTGRES_USER=vps_billing
POSTGRES_PASSWORD=change-me
# Must stay consistent with the POSTGRES_* values above.
DATABASE_URL=postgres://vps_billing:change-me@postgres:5432/vps_billing?sslmode=disable

# ---- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- HTTP server -------------------------------------------------------------
HTTP_REQUEST_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=20s

# ---- worker ------------------------------------------------------------------
WORKER_TICK_INTERVAL=30s

# ---- logging -----------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
